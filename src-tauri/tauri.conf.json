{
  "productName": "SafeKey",
  "version": "1.0.0",
  "identifier": "com.dreadonyx.safekey",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "SafeKey",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "section": "utils",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "epoch": 0,
        "release": "1"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      },
      "wix": null
    },
    "shortDescription": "Local-only encrypted password manager",
    "longDescription": "SafeKey is a secure, local-only password manager. No cloud, no syncing - your data stays on your device. Features Argon2id encryption, password generator, strength analyzer, secure notes, and TOTP support.",
    "category": "Utility",
    "copyright": "© 2026 Dreadonyx",
    "license": "MIT"
  },
  "plugins": {}
}
